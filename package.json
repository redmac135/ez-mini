{
	"name": "ez-mini",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"scripts": {
		"dev": "turbo run dev --filter='./apps/*'",
		"dev:api": "pnpm --filter @ez/apps-api dev",
		"build": "turbo run build --filter='./apps/*'",
		"deploy": "turbo run deploy --filter='./apps/*'",
		"preview": "pnpm --filter @ez/apps-blank preview",
		"prepare": "pnpm --filter @ez/apps-blank prepare",
		"test": "pnpm --filter @ez/auth test && pnpm --filter @ez/sync test && pnpm --filter @ez/apps-blank test && pnpm --filter @ez/apps-api test && node --test scripts/*.test.mjs",
		"check": "pnpm --filter @ez/apps-blank check && pnpm --filter @ez/apps-api check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"pnpm": {
		"overrides": {
			"cookie": "1.1.1"
		}
	},
	"devDependencies": {
		"@eslint/compat": "catalog:",
		"@eslint/js": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@types/node": "catalog:",
		"esbuild": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:"
	}
}
