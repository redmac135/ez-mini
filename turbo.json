{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"@ez/apps-blank#build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**", ".svelte-kit/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"deploy": {
			"dependsOn": ["build"],
			"outputs": []
		}
	}
}
